!ifdef BUILD_UNINSTALLER
Var DshInstallFilesRoot
Var DshStagedFilesRoot

!macro DshExtendedPath Input Output
  StrCpy ${Output} "${Input}" 4
  ${If} ${Output} == "\\?\"
    StrCpy ${Output} "${Input}"
  ${Else}
    StrCpy ${Output} "${Input}" 2
    ${If} ${Output} == "\\"
      StrCpy ${Output} "${Input}" "" 2
      StrCpy ${Output} "\\?\UNC\${Output}"
    ${Else}
      StrCpy ${Output} "\\?\${Input}"
    ${EndIf}
  ${EndIf}
!macroend

!macro DshUninstallFileFunctions
Function un.DshAtomicRMDir
  Exch $R0
  Push $R1
  Push $R2
  Push $R3

  StrCpy $R3 "$DshInstallFilesRoot$R0\*.*"
  FindFirst $R1 $R2 $R3

  loop:
    StrCmp $R2 "" break

    StrCmp $R2 "." continue
    StrCmp $R2 ".." continue

    IfFileExists "$DshInstallFilesRoot$R0\$R2\*.*" isDir isNotDir

    isDir:
      CreateDirectory "$DshStagedFilesRoot$R0\$R2"

      Push "$R0\$R2"
      Call un.DshAtomicRMDir
      Pop $R3

      ${if} $R3 != 0
        Goto done
      ${endIf}

      Goto continue

    isNotDir:
      ClearErrors
      Rename "$DshInstallFilesRoot$R0\$R2" "$DshStagedFilesRoot$R0\$R2"

      # Ignore errors when renaming ourselves.
      StrCmp "$R0\$R2" "${UNINSTALL_FILENAME}" 0 +2
      ClearErrors

      IfErrors 0 +3
      StrCpy $R3 "$DshInstallFilesRoot$R0\$R2"
      Goto done

    continue:
      FindNext $R1 $R2
      Goto loop

  break:
    StrCpy $R3 0

  done:
    FindClose $R1

    StrCpy $R0 $R3

    Pop $R3
    Pop $R2
    Pop $R1
    Exch $R0
FunctionEnd

Function un.DshRestoreFiles
  Exch $R0
  Push $R1
  Push $R2
  Push $R3

  StrCpy $R3 "$DshStagedFilesRoot$R0\*.*"
  FindFirst $R1 $R2 $R3

  loop:
    StrCmp $R2 "" break

    StrCmp $R2 "." continue
    StrCmp $R2 ".." continue

    IfFileExists "$DshInstallFilesRoot$R0\$R2\*.*" isDir isNotDir

    isDir:
      CreateDirectory "$DshInstallFilesRoot$R0\$R2"

      Push "$R0\$R2"
      Call un.DshRestoreFiles
      Pop $R3

      Goto continue

    isNotDir:
      Rename "$DshStagedFilesRoot$R0\$R2" "$DshInstallFilesRoot$R0\$R2"

    continue:
      FindNext $R1 $R2
      Goto loop

  break:
    StrCpy $R0 0
    FindClose $R1

    Pop $R3
    Pop $R2
    Pop $R1
    Exch $R0
FunctionEnd

!macroend

!macro customRemoveFiles
  !insertmacro DshExtendedPath "$INSTDIR" $DshInstallFilesRoot
  !insertmacro DshExtendedPath "$PLUGINSDIR\old-install" $DshStagedFilesRoot
  ${If} ${isUpdated}
    CreateDirectory "$DshStagedFilesRoot"
    Push ""
    Call un.DshAtomicRMDir
    Pop $R0
    ${If} $R0 != 0
      !insertmacro DshE2eTrace "update relocation failed: $R0"
      Push ""
      Call un.DshRestoreFiles
      Pop $R0
      Abort "Unable to relocate the previous installation."
    ${EndIf}
  ${EndIf}
  SetOutPath $TEMP
  RMDir /r "$DshInstallFilesRoot"
!macroend
!endif
